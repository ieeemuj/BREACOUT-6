generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

model TeamLogins {
  id         String  @id @default(uuid())
  track      String
  name       String
  credential String  @unique
  clueno     Int     @default(1)
  stopped    Boolean @default(false)
}

model Geolocations {
  id          String   @id @default(uuid())
  coordinate1 String[]
  coordinate2 String[]
  coordinate3 String[]
  coordinate4 String[]
  Clues       Clues[]
}

model Clues {
  id             String       @id @default(uuid())
  track          String
  name           String?
  clue           String
  location       Geolocations @relation(fields: [geolocationsId], references: [id])
  geolocationsId String
  clueno         Int
}

model Admins {
  id       Int    @id
  username String
  password String
  token    String
}
